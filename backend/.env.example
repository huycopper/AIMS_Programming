DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=aims_user
DB_PASSWORD=change-me
DB_DATABASE=aims

VIETQR_TOKEN_URL=https://dev.vietqr.org/vqr/api/token_generate
VIETQR_GENERATE_URL=https://dev.vietqr.org/vqr/api/qr/generate-customer
VIETQR_TEST_CALLBACK_URL=https://dev.vietqr.org/vqr/bank/api/test/transaction-callback
VIETQR_USERNAME=your-vietqr-username
VIETQR_PASSWORD=your-vietqr-password
BANK_CODE=MB
BANK_ACCOUNT=your-bank-account
USER_BANK_NAME=ACCOUNT HOLDER WITHOUT ACCENTS

CLIENT_USERNAME=aims-callback-client
CLIENT_PASSWORD=change-me
JWT_SECRET=replace-with-a-strong-secret

# Public frontend URL used in customer emails.
APP_PUBLIC_URL=http://localhost:4200

# Public backend URL exposed to VietQR/ngrok.
# The canonical AIMS application callback route is:
#   POST /bank/api/transaction-sync
# If infrastructure adds a base path such as /vqr, that prefix belongs to the
# deployment/public URL only, not the Nest application route.
AIMS_PUBLIC_CALLBACK_URL=https://your-public-host.example.com/bank/api/transaction-sync
