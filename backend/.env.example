# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DATABASE=aims_db

# VietQR endpoint
VIETQR_TOKEN_URL=https://dev.vietqr.org/vqr/api/token_generate
VIETQR_GENERATE_URL=https://dev.vietqr.org/vqr/api/qr/generate-customer
VIETQR_TEST_CALLBACK_URL=https://dev.vietqr.org/vqr/bank/api/test/transaction-callback

# VietQR Configuration
JWT_SECRET=your_jwt_secret
CLIENT_USERNAME=your_client_username
CLIENT_PASSWORD=your_client_password
VIETQR_USERNAME=your_vietqr_username
VIETQR_PASSWORD=your_vietqr_password

# Bank Configuration
BANK_CODE=your_bank_code
BANK_ACCOUNT=your_bank_account
USER_BANK_NAME=your_bank_account_name

# Email Configuration
EMAIL_ENABLED=false
APP_PUBLIC_URL=http://localhost:4200
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="AIMS Store" <your_email@example.com>
